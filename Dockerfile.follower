FROM golang:1.23-alpine AS builder

RUN apk add --no-cache gcc musl-dev linux-headers git make

RUN git clone https://github.com/primev/mev-commit.git /mev-commit
WORKDIR /mev-commit
RUN git checkout follower
WORKDIR /mev-commit/cl

RUN go mod tidy
RUN go build -o snode ./cmd/singlenode/main.go

FROM alpine:latest

COPY --from=builder /mev-commit/cl/snode /usr/local/bin/

COPY entrypoint_follower.sh /entrypoint_follower.sh
RUN chmod +x /entrypoint_follower.sh

ENTRYPOINT ["/entrypoint_follower.sh"]
